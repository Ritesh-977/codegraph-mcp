NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme123
NEO4J_DB=neo4j
REPOS_DIR=./repos
INGEST_BATCH_SIZE=200
INGEST_DEPTH=1
MAX_DEPENDENCY_RESULTS=500
# Private repos: SSH keys and your OS credential helper work with no token at
# all. GIT_TOKEN is only needed for headless/CI use.
# GIT_TOKEN=
# Scope the token to one host. Leave unset and the token is sent to whatever
# https host you clone — set this if you use more than one git host.
# GIT_TOKEN_HOST=github.com
# Username paired with the token. Defaults per host (github: none,
# bitbucket.org: x-token-auth, gitlab.com: oauth2). Set for a Bitbucket app
# password (your username) or a self-hosted instance.
# GIT_TOKEN_USERNAME=
LOG_LEVEL=INFO
# Local web UI (`codegraph viz`)
VIZ_HOST=127.0.0.1
VIZ_PORT=8787
